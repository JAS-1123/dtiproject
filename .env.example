# xAI Grok API key. Create one at https://console.x.ai/
# Never commit a real key to GitHub or expose it in frontend code.
XAI_API_KEY=
XAI_MODEL=grok-4.7
DEFAULT_BOOK_ID=pride-and-prejudice

# Only needed when frontend and API are hosted on different origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
